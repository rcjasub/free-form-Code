# Values docker compose fills into docker-compose.yml. Copy this file to .env
# (same folder) and fill it in; .env is git-ignored, so the real values never
# reach GitHub. The backend's own settings live in backend/.env.

# The database superuser's. Only applied when the database is first created;
# for an existing database, use the one it already has.
POSTGRES_PASSWORD=

# What the backend logs in with. Same value as above unless you've set up a
# separate database login for it.
DB_PASSWORD=
