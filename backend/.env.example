DB_HOST=localhost
DB_PORT=5432
DB_NAME=freeformcode
DB_USER=postgres
DB_PASSWORD=

PORT=4000

# Code-execution sandbox (Piston). Local dev only: start it with
#   docker compose --profile local up -d piston
# Leave unset on the deployed server: code running is then disabled.
PISTON_URL=http://localhost:2000

# Storage limits. Leave them unset to run it yourself with the defaults (no
# limit on canvases per account, 500 blocks and 50 MB per canvas). A small
# public server, like a demo on a VM with a little disk, can tighten them:
# MAX_CANVASES_PER_USER=10
# MAX_BLOCKS_PER_CANVAS=500
# MAX_CANVAS_CONTENT_MB=10
